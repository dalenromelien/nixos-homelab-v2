# Homelab Machine Configuration Template
# 
# This file is optional. Use it to customize your homelab machine on top of
# the configuration tracked by your flake.
#
# After installation, if you want local customizations, copy this to
# /etc/nixos/configuration.nix and modify it.
#
# WARNING: If you edit /etc/nixos/flake.nix or add a configuration.nix,
# you must run "sudo nixos-rebuild switch" instead of relying on auto-updates.

{ config, pkgs, lib, ... }:

{
  # Your machine's core configuration comes from:
  # /etc/nixos/flake.nix -> github:dalenromelien/nixos-homelab-v2
  #
  # That flake defines:
  # - All services (Immich, Nextcloud, AdGuard, Netbird, etc.)
  # - Auto-update schedule (Sunday 3am weekly)
  # - Networking and firewall rules
  # - Storage and RAID configuration
  # - System packages and utilities

  # CUSTOMIZATION EXAMPLES
  # Uncomment and modify any of these to override the homelab defaults:

  # Disable auto-updates if you want manual control
  # homelab.services.autoUpdate.enable = lib.mkForce false;

  # Add additional system packages
  # environment.systemPackages = with pkgs; [
  #   vim
  #   htop
  #   ncdu
  # ];

  # Customize networking
  # networking.firewall.allowedTCPPorts = [ 22 80 443 8080 ];
  # networking.firewall.allowedUDPPorts = [ 53 ];

  # Increase resource limits for specific services
  # systemd.services.immich.serviceConfig.MemoryLimit = "4G";

  # Enable additional modules or services
  # services.openssh.enable = true;
  # services.openssh.permitRootLogin = "no";

  # For more NixOS options, see:
  # https://search.nixos.org/options
}
